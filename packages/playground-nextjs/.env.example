# Get these env vars from tidbcloud.com
DATABASE_URL=

# Server-only; use actual allowed database names / a private API token.
STATEMENT_ALLOWED_DATABASES=

# Server-only; use actual allowed database names / a private API token.
STATEMENT_API_TOKEN=

# Server-only token required by every /api endpoint (Authorization: Bearer ...).
# When set, API_TOKEN takes precedence over the legacy STATEMENT_API_TOKEN.
API_TOKEN=
